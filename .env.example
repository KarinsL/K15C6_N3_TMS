# Copy to .env and adjust. docker compose reads this file automatically.
POSTGRES_DB=tms
POSTGRES_USER=tms
POSTGRES_PASSWORD=tms
# At least 32 characters. Never commit a real secret.
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
